{
  "name": "@rtc-less/rtc-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Astro SSG frontend for rtc-less video conferencing",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:compat": "eslint --config eslint.compat.config.mjs \"src/**/*.astro\"",
    "lint:compat:self-test": "node scripts/lint-compat-self-test.mjs",
    "astro": "astro"
  },
  "browserslist": [
    "chrome >= 108",
    "firefox >= 108",
    "safari >= 16",
    "edge >= 108"
  ],
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^13.1.8",
    "@astrojs/node": "9",
    "@rtc-less/rtc-components": "workspace:*",
    "astro": "^6.4.8",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.31.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-compat": "^6.0.2"
  }
}
