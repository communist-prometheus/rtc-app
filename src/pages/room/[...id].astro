---
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = () => [{ params: { id: undefined } }]
---

<BaseLayout title="Room | rtc-less" navVariant="full">
  <section id="room">
    <dialog id="nickname-dialog" aria-labelledby="nickname-title">
      <form method="dialog" id="nickname-form">
        <h2 id="nickname-title">Enter your nickname</h2>
        <p id="nickname-error" role="alert" hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="12" y1="7" x2="12" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="17" r="1" fill="currentColor"/>
          </svg>
          <span id="nickname-error-text">This nickname is already taken in this room.</span>
        </p>
        <input
          id="nickname-input"
          type="text"
          required
          autocomplete="off"
          minlength="1"
          maxlength="32"
          placeholder="e.g. Alice"
          aria-describedby="nickname-error"
        />
        <button id="nickname-submit" type="submit">Join Room</button>
      </form>
    </dialog>

    <nav id="toolbar">
      <output id="room-info">Loading...</output>
      <button id="copy-link" type="button" aria-label="Copy room link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span>Copy</span>
      </button>
      <button id="btn-rename" type="button" aria-label="Change nickname">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        <span>Rename</span>
      </button>
      <span id="peer-count">0 participants</span>
      <span id="connection-status" role="status" data-state="connecting" aria-live="polite">Connecting…</span>
    </nav>

    <main id="video-area">
      <section id="remote-grid"></section>
      <aside id="self-view">
        <video id="local-video" autoplay muted playsinline></video>
        <span id="self-label">You</span>
      </aside>
    </main>

    <footer id="controls">
      <button id="btn-mic" type="button" aria-pressed="false" aria-label="Mute microphone">
        <svg class="icon-on" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="2" width="6" height="12" rx="3"/>
          <path d="M5 10a7 7 0 0 0 14 0"/>
          <line x1="12" y1="17" x2="12" y2="22"/>
        </svg>
        <svg class="icon-off" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="2" width="6" height="12" rx="3"/>
          <path d="M5 10a7 7 0 0 0 14 0"/>
          <line x1="12" y1="17" x2="12" y2="22"/>
          <line x1="3" y1="3" x2="21" y2="21" stroke-width="2.5"/>
        </svg>
      </button>
      <button id="btn-cam" type="button" aria-pressed="false" aria-label="Turn camera off">
        <svg class="icon-on" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 7l-7 5 7 5V7z"/>
          <rect x="1" y="5" width="15" height="14" rx="2"/>
        </svg>
        <svg class="icon-off" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 7l-7 5 7 5V7z"/>
          <rect x="1" y="5" width="15" height="14" rx="2"/>
          <line x1="3" y1="3" x2="21" y2="21" stroke-width="2.5"/>
        </svg>
      </button>
      <button id="btn-share" type="button" aria-pressed="false" aria-label="Share screen" aria-keyshortcuts="Control+Shift+S">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"/>
          <polyline points="8 21 12 17 16 21"/>
        </svg>
      </button>
      <button id="btn-chat" type="button" aria-pressed="false" aria-label="Toggle chat">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </button>
      <button id="btn-log" type="button" aria-pressed="false" aria-label="Toggle debug log" aria-keyshortcuts="Control+Shift+L">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/>
          <line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
      </button>
      <button id="btn-leave" type="button" aria-label="Leave call">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91" transform="rotate(135 12 12)"/>
        </svg>
      </button>
    </footer>

    <aside id="chat-panel" class="side-panel hidden">
      <header>
        <h3>Chat</h3>
        <button id="close-chat" type="button" aria-label="Close chat">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </header>
      <ol id="chat-messages"></ol>
      <form id="chat-form">
        <input id="chat-input" type="text" placeholder="Message..." autocomplete="off" />
        <button type="submit" aria-label="Send">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </form>
    </aside>

    <aside id="log-panel" class="side-panel hidden">
      <header>
        <h3>Debug Log</h3>
        <button id="close-log" type="button" aria-label="Close log">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </header>
      <ol id="log-entries"></ol>
    </aside>

    <div id="notifications" aria-live="polite"></div>
  </section>
</BaseLayout>

<script>
  import { telemetry } from '@/lib/telemetry'

  /* ── helpers ── */
  const $ = <T extends HTMLElement>(s: string) =>
    document.querySelector<T>(s)

  const log = (msg: string, level = 'info') => {
    const li = document.createElement('li')
    li.className = level
    li.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`
    $('#log-entries')?.appendChild(li)
    li.scrollIntoView({ block: 'end' })
    console.log(`[${level}] ${msg}`)
  }

  const notify = (text: string) => {
    const el = $('#notifications')
    if (!el) return
    const n = document.createElement('div')
    n.className = 'toast'
    n.textContent = text
    el.appendChild(n)
    setTimeout(() => n.remove(), 4000)
  }

  const getRoomId = (): string => {
    const m = globalThis.location.pathname.match(/\/room\/(.+)/)
    return m?.[1] ?? globalThis.crypto.randomUUID()
  }

  const getSignalHost = (): string =>
    globalThis.location.port === '4321'
      ? 'localhost:8787'
      : 'signal.comprom.org'

  const checkNicknameAvailable = async (
    roomId: string,
    nickname: string
  ): Promise<boolean> => {
    const proto = globalThis.location.protocol === 'https:' ? 'https:' : 'http:'
    const url = `${proto}//${getSignalHost()}/api/check-nickname/${roomId}?nickname=${encodeURIComponent(nickname)}`
    try {
      const r = await fetch(url)
      const d = await r.json() as { taken: boolean }
      return !d.taken
    } catch {
      return true
    }
  }

  const promptNickname = async (roomId: string): Promise<string> => {
    const dialog = $<HTMLDialogElement>('#nickname-dialog')
    const form = $<HTMLFormElement>('#nickname-form')
    const input = $<HTMLInputElement>('#nickname-input')
    const error = $<HTMLElement>('#nickname-error')
    if (!dialog || !form || !input || !error) throw new Error('dialog missing')

    const savedKey = `rtc-less-nickname:${roomId}`
    const saved = localStorage.getItem(savedKey) ?? localStorage.getItem('rtc-less-nickname')
    if (saved) input.value = saved

    const card = form
    dialog.showModal()
    requestAnimationFrame(() => input.focus())

    return new Promise<string>(resolve => {
      const cleanup = () => {
        form.removeEventListener('submit', submit)
        dialog.removeEventListener('cancel', cancel)
      }
      const cancel = (e: Event) => {
        e.preventDefault()
        input.focus()
      }
      const submit = async (e: Event) => {
        e.preventDefault()
        const nickname = input.value.trim()
        if (!nickname || nickname.length > 32) {
          error.hidden = false
          const errText = $<HTMLElement>('#nickname-error-text')
          if (errText) errText.textContent = 'Please enter a valid nickname (1-32 chars).'
          return
        }
        error.hidden = true
        const available = await checkNicknameAvailable(roomId, nickname)
        if (!available) {
          error.hidden = false
          const errText = $<HTMLElement>('#nickname-error-text')
          if (errText) errText.textContent = 'This nickname is already taken in this room.'
          card.classList.remove('shake')
          void card.offsetWidth
          card.classList.add('shake')
          input.select()
          return
        }
        localStorage.setItem(savedKey, nickname)
        localStorage.setItem('rtc-less-nickname', nickname)
        cleanup()
        dialog.close()
        resolve(nickname)
      }
      form.addEventListener('submit', submit)
      dialog.addEventListener('cancel', cancel)
    })
  }

  /* ── state ── */
  const peers = new Map<string, {
    pc: RTCPeerConnection
    el: HTMLElement
    video: HTMLVideoElement
    nickname: string
    relayActive?: boolean
    relayInterval?: ReturnType<typeof setInterval>
    relaySourceVideo?: HTMLVideoElement
    relayImg?: HTMLImageElement
    lastImgUrl?: string
    audioCtx?: AudioContext
    audioProcessor?: ScriptProcessorNode
    playbackCtx?: AudioContext
    nextPlayTime?: number
    disconnectTimer?: ReturnType<typeof setTimeout>
    iceTimer?: ReturnType<typeof setTimeout>
    restartAttempts?: number
    remoteTrackSeen?: boolean
  }>()

  let localStream: MediaStream | undefined
  let displayStream: MediaStream | undefined
  let isSharing = false
  let userId = ''
  let telemetrySessionId = ''
  let telemetryConnectionId = ''
  let qualityPollTimer: ReturnType<typeof setInterval> | undefined
  let ws: WebSocket | undefined
  let wsUrl = ''
  let wsAttempt = 0
  let heartbeatTimer: ReturnType<typeof setInterval> | undefined
  let heartbeatPongTimer: ReturnType<typeof setTimeout> | undefined
  let lastHeartbeatSent = 0
  let reconnectTimer: ReturnType<typeof setTimeout> | undefined
  let audioMuted = false
  let videoMuted = false
  let localNicknameRef = ''
  let shutdownRequested = false

  const iceServers: RTCIceServer[] = []
  const ICE_TIMEOUT_MS = 5000
  const HEARTBEAT_INTERVAL_MS = 15_000
  const HEARTBEAT_TIMEOUT_MS = 5_000
  const WS_BACKOFF_MIN_MS = 500
  const WS_BACKOFF_MAX_MS = 8_000
  const forceRelay = new URLSearchParams(globalThis.location.search).get('forceRelay') === '1'

  const setConnState = (state: 'connecting' | 'connected' | 'reconnecting' | 'offline'): void => {
    document.body.setAttribute('data-conn-state', state)
    const el = $('#connection-status')
    if (!el) return
    el.setAttribute('data-state', state)
    el.textContent =
      state === 'connected' ? 'Connected' :
      state === 'connecting' ? 'Connecting…' :
      state === 'reconnecting' ? 'Reconnecting…' :
      'Offline'
  }

  const sendWs = (msg: unknown): boolean => {
    if (!ws || ws.readyState !== WebSocket.OPEN) return false
    try {
      ws.send(JSON.stringify(msg))
      return true
    } catch {
      return false
    }
  }

  const sendWsBinary = (buf: ArrayBuffer): boolean => {
    if (!ws || ws.readyState !== WebSocket.OPEN) return false
    try {
      ws.send(buf)
      return true
    } catch {
      return false
    }
  }

  /* ── peer connection ── */
  const restartPeerIce = async (remoteId: string): Promise<void> => {
    const peer = peers.get(remoteId)
    if (!peer) return
    peer.restartAttempts = (peer.restartAttempts ?? 0) + 1
    log(
      `stability:ice:restart ${remoteId.slice(0, 8)} attempt=${String(peer.restartAttempts)}`,
      'warn'
    )
    // Only the offerer (lexicographically smaller peer id) initiates.
    if (userId && userId < remoteId) {
      try {
        peer.pc.restartIce()
        const offer = await peer.pc.createOffer({ iceRestart: true })
        await peer.pc.setLocalDescription(offer)
        sendWs({
          type: 'offer',
          target: remoteId,
          sdp: offer.sdp,
        })
      } catch (err) {
        log(
          `stability:ice:restart:failed ${(err as { name?: string } | null)?.name ?? 'unknown'}`,
          'error'
        )
      }
    }
  }

  const fallbackToRelay = (remoteId: string, reason: string): void => {
    const peer = peers.get(remoteId)
    if (!peer || peer.relayActive) return
    log(
      `stability:relay:fallback ${remoteId.slice(0, 8)} reason=${reason}`,
      'warn'
    )
    notify('Using server relay')
    startRelay(remoteId)
  }

  const createPeerConnection = (remoteId: string): RTCPeerConnection => {
    const pc = new RTCPeerConnection({ iceServers })

    if (localStream) {
      localStream.getTracks().forEach(t => pc.addTrack(t, localStream!))
    }

    pc.onicecandidate = e => {
      if (e.candidate) {
        sendWs({
          type: 'ice-candidate',
          target: remoteId,
          candidate: e.candidate.candidate,
          sdpMid: e.candidate.sdpMid,
          sdpMLineIndex: e.candidate.sdpMLineIndex,
        })
      }
    }

    pc.ontrack = e => {
      log(`Track received from ${remoteId.slice(0, 8)}`, 'success')
      const peer = peers.get(remoteId)
      if (peer && e.streams[0]) {
        peer.video.srcObject = e.streams[0]
        peer.remoteTrackSeen = true
      }
    }

    const iceTimer = setTimeout(() => {
      const state = pc.iceConnectionState
      if (state !== 'connected' && state !== 'completed') {
        const peer = peers.get(remoteId)
        if (peer && !peer.relayActive) {
          fallbackToRelay(remoteId, 'p2p-timeout')
        }
      }
    }, ICE_TIMEOUT_MS)

    pc.oniceconnectionstatechange = () => {
      const state = pc.iceConnectionState
      log(`ICE ${remoteId.slice(0, 8)}: ${state}`)
      const peer = peers.get(remoteId)
      if (!peer) return

      if (state === 'connected' || state === 'completed') {
        clearTimeout(iceTimer)
        if (peer.disconnectTimer) {
          clearTimeout(peer.disconnectTimer)
          delete peer.disconnectTimer
        }
        peer.restartAttempts = 0
        log(
          `stability:ice:connected ${remoteId.slice(0, 8)}`,
          'success'
        )
        if (telemetryConnectionId) {
          void telemetry.trackIceEvent(
            telemetryConnectionId,
            'connected',
            { 'ice.state': state, 'ice.peer': remoteId }
          )
          // First time we hit a connected ICE — start sampling stats.
          // Polling earlier produces all-zero rows that skew the
          // dashboard aggregates.
          if (!qualityPollTimer) startQualityPolling()
        }
        return
      }

      if (state === 'disconnected') {
        // Transient — give it 4s to recover, then restart ICE.
        if (peer.disconnectTimer) return
        peer.disconnectTimer = setTimeout(() => {
          delete peer.disconnectTimer
          if (pc.iceConnectionState === 'disconnected') {
            void restartPeerIce(remoteId)
          }
        }, 4000)
        return
      }

      if (state === 'failed') {
        clearTimeout(iceTimer)
        if (peer.disconnectTimer) {
          clearTimeout(peer.disconnectTimer)
          delete peer.disconnectTimer
        }
        if (telemetryConnectionId) {
          void telemetry.trackIceEvent(
            telemetryConnectionId,
            'failed',
            { 'ice.state': state, 'ice.peer': remoteId }
          )
        }
        // Attempt ICE restart once before falling back to relay.
        if ((peer.restartAttempts ?? 0) < 1) {
          void restartPeerIce(remoteId)
          setTimeout(() => {
            if (pc.iceConnectionState !== 'connected' &&
                pc.iceConnectionState !== 'completed') {
              fallbackToRelay(remoteId, 'ice-failed')
            }
          }, 5000)
        } else {
          fallbackToRelay(remoteId, 'ice-failed')
        }
      }
    }

    return pc
  }

  /* ── WebSocket frame relay: video (JPEG) + audio (PCM16) ── */
  const PEER_ID_BYTES = 36
  const RELAY_FPS = 10
  const RELAY_QUALITY = 0.6
  const RELAY_MAX_DIMENSION = 480
  const AUDIO_SAMPLE_RATE = 16000
  const AUDIO_BUFFER_SIZE = 2048
  const TYPE_VIDEO = 0x76 // 'v' - [width:2][height:2][jpeg]
  const TYPE_AUDIO = 0x61 // 'a' - [pcm16]

  const buildFrame = (
    targetId: string,
    type: number,
    payload: ArrayBuffer
  ): ArrayBuffer => {
    const header = new TextEncoder().encode(targetId)
    const frame = new Uint8Array(PEER_ID_BYTES + 1 + payload.byteLength)
    frame.set(header, 0)
    frame[PEER_ID_BYTES] = type
    frame.set(new Uint8Array(payload), PEER_ID_BYTES + 1)
    return frame.buffer
  }

  const buildVideoFrame = (
    targetId: string,
    width: number,
    height: number,
    jpegBuf: ArrayBuffer
  ): ArrayBuffer => {
    const headerBytes = new TextEncoder().encode(targetId)
    const frame = new Uint8Array(
      PEER_ID_BYTES + 1 + 4 + jpegBuf.byteLength
    )
    frame.set(headerBytes, 0)
    frame[PEER_ID_BYTES] = TYPE_VIDEO
    const dv = new DataView(frame.buffer)
    dv.setUint16(PEER_ID_BYTES + 1, width, false)
    dv.setUint16(PEER_ID_BYTES + 3, height, false)
    frame.set(new Uint8Array(jpegBuf), PEER_ID_BYTES + 5)
    return frame.buffer
  }

  const computeRelayDims = (
    videoW: number,
    videoH: number
  ): { w: number; h: number } => {
    if (videoW === 0 || videoH === 0) {
      return { w: 480, h: 270 }
    }
    if (videoW >= videoH) {
      const w = Math.min(RELAY_MAX_DIMENSION, videoW)
      const h = Math.round((w * videoH) / videoW)
      return { w, h }
    }
    const h = Math.min(RELAY_MAX_DIMENSION, videoH)
    const w = Math.round((h * videoW) / videoH)
    return { w, h }
  }

  const startRelay = (remoteId: string) => {
    const peer = peers.get(remoteId)
    if (!peer || peer.relayActive) return
    peer.relayActive = true

    if (!localStream) {
      log('No local stream for relay', 'error')
      return
    }

    const videoTrack = localStream.getVideoTracks()[0]
    const audioTrack = localStream.getAudioTracks()[0]

    /* ── video relay ── */
    if (videoTrack) {
      const sourceVideo = document.createElement('video')
      sourceVideo.srcObject = new MediaStream([videoTrack])
      sourceVideo.muted = true
      sourceVideo.playsInline = true
      sourceVideo.className = 'relay-source'
      sourceVideo.setAttribute('data-peer-id', remoteId)
      // Attach (hidden) so the track is playable across browsers and
      // discoverable by E2E assertions scoped past #local-video.
      document.body.appendChild(sourceVideo)
      sourceVideo.play().catch(() => {})
      peer.relaySourceVideo = sourceVideo

      const canvas = document.createElement('canvas')
      const ctx = canvas.getContext('2d')

      const captureVideo = async () => {
        if (
          !peer.relayActive ||
          !ws ||
          ws.readyState !== WebSocket.OPEN ||
          !ctx ||
          document.visibilityState === 'hidden'
        ) return
        try {
          const vw = sourceVideo.videoWidth
          const vh = sourceVideo.videoHeight
          if (vw === 0 || vh === 0) return

          const { w, h } = computeRelayDims(vw, vh)
          if (canvas.width !== w || canvas.height !== h) {
            canvas.width = w
            canvas.height = h
          }

          ctx.drawImage(sourceVideo, 0, 0, w, h)
          const blob = await new Promise<Blob | null>(resolve =>
            canvas.toBlob(resolve, 'image/jpeg', RELAY_QUALITY)
          )
          if (!blob) return
          const buf = await blob.arrayBuffer()
          sendWsBinary(buildVideoFrame(remoteId, w, h, buf))
        } catch {}
      }

      peer.relayInterval = setInterval(captureVideo, 1000 / RELAY_FPS)
    }

    /* ── audio relay (PCM16 mono 16kHz) ── */
    if (audioTrack) {
      const AudioCtx = globalThis.AudioContext ??
        (globalThis as Record<string, unknown>)['webkitAudioContext']
      const audioCtx = new (AudioCtx as typeof AudioContext)({
        sampleRate: AUDIO_SAMPLE_RATE,
      })
      const source = audioCtx.createMediaStreamSource(
        new MediaStream([audioTrack])
      )
      const processor = audioCtx.createScriptProcessor(
        AUDIO_BUFFER_SIZE, 1, 1
      )

      processor.onaudioprocess = e => {
        if (
          !peer.relayActive ||
          !ws ||
          ws.readyState !== WebSocket.OPEN
        ) return
        const input = e.inputBuffer.getChannelData(0)
        const pcm = new Int16Array(input.length)
        for (let i = 0; i < input.length; i++) {
          const s = Math.max(-1, Math.min(1, input[i]!))
          pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff
        }
        sendWsBinary(buildFrame(remoteId, TYPE_AUDIO, pcm.buffer))
      }

      source.connect(processor)
      processor.connect(audioCtx.destination)
      peer.audioCtx = audioCtx
      peer.audioProcessor = processor
    }

    log(`Relay active → ${remoteId.slice(0, 8)} (video+audio)`, 'success')
  }

  const handleRelayData = (
    senderId: string,
    type: number,
    payload: ArrayBuffer
  ) => {
    const peer = peers.get(senderId)
    if (!peer) return

    if (type === TYPE_VIDEO) {
      if (payload.byteLength < 4) return
      const jpeg = payload.slice(4)

      if (!peer.relayImg) {
        const img = document.createElement('img')
        img.className = 'relay-img'
        img.alt = ''
        peer.relayImg = img
        peer.video.style.display = 'none'
        peer.el.insertBefore(img, peer.video)
        log(`Relay receiver ready for ${senderId.slice(0, 8)}`, 'success')
      }

      const imgEl = peer.relayImg
      const blob = new Blob([jpeg], { type: 'image/jpeg' })
      const newUrl = URL.createObjectURL(blob)
      const oldUrl = peer.lastImgUrl
      imgEl.src = newUrl
      peer.lastImgUrl = newUrl
      if (oldUrl) {
        queueMicrotask(() => URL.revokeObjectURL(oldUrl))
      }
      return
    }

    if (type === TYPE_AUDIO) {
      if (!peer.playbackCtx) {
        const AudioCtx = globalThis.AudioContext ??
          (globalThis as Record<string, unknown>)['webkitAudioContext']
        peer.playbackCtx = new (AudioCtx as typeof AudioContext)({
          sampleRate: AUDIO_SAMPLE_RATE,
        })
        peer.nextPlayTime = peer.playbackCtx.currentTime
      }

      const ctx = peer.playbackCtx
      const pcm = new Int16Array(payload)
      const float = new Float32Array(pcm.length)
      for (let i = 0; i < pcm.length; i++) {
        float[i] = pcm[i]! / (pcm[i]! < 0 ? 0x8000 : 0x7fff)
      }

      const buffer = ctx.createBuffer(1, float.length, AUDIO_SAMPLE_RATE)
      buffer.copyToChannel(float, 0)

      const src = ctx.createBufferSource()
      src.buffer = buffer
      src.connect(ctx.destination)

      const now = ctx.currentTime
      const startTime = Math.max(peer.nextPlayTime ?? now, now)
      src.start(startTime)
      peer.nextPlayTime = startTime + buffer.duration
    }
  }

  const addRemotePeer = (
    remoteId: string,
    nickname: string
  ): void => {
    if (peers.has(remoteId)) return

    if (forceRelay) {
      log(`Force relay mode for ${nickname}`, 'warn')
    }

    const el = document.createElement('article')
    el.className = 'remote-peer'
    el.id = `peer-${remoteId}`

    const video = document.createElement('video')
    video.autoplay = true
    video.playsInline = true

    const label = document.createElement('span')
    label.className = 'peer-label'
    label.textContent = nickname

    el.appendChild(video)
    el.appendChild(label)
    $('#remote-grid')?.appendChild(el)

    const pc = createPeerConnection(remoteId)
    peers.set(remoteId, { pc, el, video, nickname })
    updatePeerCount()

    if (forceRelay) {
      startRelay(remoteId)
    }
  }

  const removeRemotePeer = (remoteId: string): void => {
    const peer = peers.get(remoteId)
    if (!peer) return
    peer.pc.close()
    if (peer.relayInterval) clearInterval(peer.relayInterval)
    if (peer.relaySourceVideo) {
      peer.relaySourceVideo.srcObject = null
      peer.relaySourceVideo.remove()
    }
    if (peer.audioProcessor) {
      try { peer.audioProcessor.disconnect() } catch {}
    }
    if (peer.audioCtx) {
      peer.audioCtx.close().catch(() => {})
    }
    if (peer.playbackCtx) {
      peer.playbackCtx.close().catch(() => {})
    }
    if (peer.lastImgUrl) {
      URL.revokeObjectURL(peer.lastImgUrl)
    }
    peer.el.remove()
    peers.delete(remoteId)
    updatePeerCount()
  }

  const updatePeerCount = () => {
    const el = $('#peer-count')
    if (el) el.textContent = `${peers.size + 1} participants`
  }

  /* ── signaling ── */
  const sendOffer = async (remoteId: string) => {
    const peer = peers.get(remoteId)
    if (!peer) return
    const offer = await peer.pc.createOffer()
    await peer.pc.setLocalDescription(offer)
    sendWs({
      type: 'offer',
      target: remoteId,
      sdp: offer.sdp,
    })
    log(`Offer sent to ${remoteId.slice(0, 8)}`)
  }

  const handleOffer = async (from: string, sdp: string) => {
    if (!peers.has(from)) {
      addRemotePeer(from, from.slice(0, 8))
    }
    const peer = peers.get(from)!
    await peer.pc.setRemoteDescription({ type: 'offer', sdp })
    const answer = await peer.pc.createAnswer()
    await peer.pc.setLocalDescription(answer)
    sendWs({
      type: 'answer',
      target: from,
      sdp: answer.sdp,
    })
    log(`Answer sent to ${from.slice(0, 8)}`)
  }

  const handleAnswer = async (from: string, sdp: string) => {
    const peer = peers.get(from)
    if (!peer) return
    await peer.pc.setRemoteDescription({ type: 'answer', sdp })
    log(`Answer received from ${from.slice(0, 8)}`)
  }

  const handleIceCandidate = async (
    from: string,
    candidate: string,
    sdpMid: string | null,
    sdpMLineIndex: number | null
  ) => {
    const peer = peers.get(from)
    if (!peer) return
    await peer.pc.addIceCandidate({ candidate, sdpMid, sdpMLineIndex })
  }

  const handleSignalingMessage = async (data: string) => {
    const msg = JSON.parse(data)

    switch (msg.type) {
      case 'room-state': {
        userId = msg.userId
        log(`Joined as ${msg.nickname}. ${msg.users.length} in room.`, 'success')
        // Telemetry: track this peer's connection in the session.
        // Quality polling deliberately doesn't start here — it's
        // gated on the first ICE 'connected' event so we don't push
        // all-zero stats rows during negotiation.
        if (telemetrySessionId && !telemetryConnectionId) {
          telemetryConnectionId =
            await telemetry.trackUserConnect(
              telemetrySessionId,
              userId,
              msg.nickname ?? ''
            )
        }
        type User = { id: string; nickname: string }
        const others = (msg.users as User[]).filter(u => u.id !== userId)
        for (const u of others) {
          addRemotePeer(u.id, u.nickname)
          if (!forceRelay) {
            await sendOffer(u.id)
          }
        }
        break
      }
      case 'peer-joined': {
        const nick = msg.nickname ?? msg.userId.slice(0, 8)
        log(`${nick} joined`, 'success')
        notify(`${nick} joined the room`)
        addRemotePeer(msg.userId, nick)
        break
      }
      case 'peer-left': {
        const nick = msg.nickname ?? msg.userId.slice(0, 8)
        log(`${nick} left`, 'warn')
        notify(`${nick} left the room`)
        removeRemotePeer(msg.userId)
        break
      }
      case 'offer': {
        await handleOffer(msg.from, msg.sdp)
        break
      }
      case 'answer': {
        await handleAnswer(msg.from, msg.sdp)
        break
      }
      case 'ice-candidate': {
        await handleIceCandidate(
          msg.from, msg.candidate,
          msg.sdpMid, msg.sdpMLineIndex
        )
        break
      }
      case 'chat': {
        const peer = peers.get(msg.from)
        const fromLabel = peer?.nickname ?? msg.from.slice(0, 8)
        addChatMessage(fromLabel, msg.text)
        break
      }
      case 'peer-renamed': {
        const peer = peers.get(msg.userId)
        if (peer) {
          peer.nickname = msg.nickname
          const label = peer.el.querySelector<HTMLSpanElement>('.peer-label')
          if (label) label.textContent = msg.nickname
          log(
            `stability:peer:nick:${msg.oldNickname}->${msg.nickname}`
          )
          notify(`${msg.oldNickname} is now ${msg.nickname}`)
        }
        break
      }
      case 'rename-ok': {
        localNicknameRef = msg.nickname
        try {
          localStorage.setItem('rtc-less-nickname', msg.nickname)
        } catch {}
        const selfLabel = $('#self-label')
        if (selfLabel) selfLabel.textContent = msg.nickname
        log(`stability:rename:ok ${msg.nickname}`, 'success')
        break
      }
      case 'rename-error': {
        log(`stability:rename:error ${msg.code}`, 'error')
        notify(
          msg.code === 'NICKNAME_TAKEN'
            ? `"${msg.nickname}" is already taken`
            : 'Could not rename'
        )
        break
      }
      case 'pong': {
        if (heartbeatPongTimer) {
          clearTimeout(heartbeatPongTimer)
          heartbeatPongTimer = undefined
        }
        break
      }
    }
  }

  /* ── chat ── */
  const addChatMessage = (from: string, text: string) => {
    const li = document.createElement('li')
    const nameEl = document.createElement('strong')
    nameEl.textContent = `${from}: `
    li.appendChild(nameEl)
    li.appendChild(document.createTextNode(text))
    $('#chat-messages')?.appendChild(li)
    li.scrollIntoView({ block: 'end' })
  }

  /* ── media controls ── */
  const toggleMic = () => {
    audioMuted = !audioMuted
    localStream?.getAudioTracks().forEach(t => { t.enabled = !audioMuted })
    const btn = $('#btn-mic')
    if (btn) {
      btn.setAttribute('aria-pressed', String(audioMuted))
      btn.setAttribute('aria-label', audioMuted ? 'Unmute microphone' : 'Mute microphone')
    }
    log(audioMuted ? 'Microphone muted' : 'Microphone unmuted')
  }

  const toggleCam = () => {
    videoMuted = !videoMuted
    localStream?.getVideoTracks().forEach(t => { t.enabled = !videoMuted })
    const btn = $('#btn-cam')
    if (btn) {
      btn.setAttribute('aria-pressed', String(videoMuted))
      btn.setAttribute('aria-label', videoMuted ? 'Turn camera on' : 'Turn camera off')
    }
    log(videoMuted ? 'Camera off' : 'Camera on')
  }

  const swapOutgoingVideoTrack = async (track: MediaStreamTrack): Promise<void> => {
    for (const peer of peers.values()) {
      const sender = peer.pc
        .getSenders()
        .find(s => s.track?.kind === 'video')
      if (sender) await sender.replaceTrack(track)
      if (peer.relayActive && peer.relaySourceVideo) {
        peer.relaySourceVideo.srcObject = new MediaStream([track])
        peer.relaySourceVideo.play().catch(() => {})
      }
    }
  }

  const stopShare = async (): Promise<void> => {
    if (!isSharing) return
    isSharing = false
    displayStream?.getTracks().forEach(t => t.stop())
    displayStream = undefined
    const camTrack = localStream?.getVideoTracks()[0]
    if (camTrack) {
      camTrack.enabled = !videoMuted
      await swapOutgoingVideoTrack(camTrack)
    }
    const localVideo = $<HTMLVideoElement>('#local-video')
    if (localVideo && localStream) localVideo.srcObject = localStream
    const btn = $('#btn-share')
    if (btn) btn.setAttribute('aria-pressed', 'false')
    log('Screen share stopped')
  }

  const startShare = async (): Promise<void> => {
    if (isSharing) return
    try {
      const stream = await globalThis.navigator.mediaDevices.getDisplayMedia({
        video: true,
        audio: false,
      })
      const newTrack = stream.getVideoTracks()[0]
      if (!newTrack) {
        stream.getTracks().forEach(t => t.stop())
        return
      }
      displayStream = stream
      isSharing = true
      await swapOutgoingVideoTrack(newTrack)
      const localVideo = $<HTMLVideoElement>('#local-video')
      if (localVideo) localVideo.srcObject = stream
      const camTrack = localStream?.getVideoTracks()[0]
      if (camTrack) camTrack.enabled = false
      // Sync button state when the user stops sharing via browser chrome.
      newTrack.addEventListener('ended', () => { void stopShare() }, { once: true })
      const btn = $('#btn-share')
      if (btn) btn.setAttribute('aria-pressed', 'true')
      log('Screen share started', 'success')
    } catch (err) {
      const name = (err as { name?: string } | null)?.name ?? ''
      if (name !== 'NotAllowedError' && name !== 'AbortError') {
        log(`Screen share failed: ${name || 'unknown'}`, 'error')
      }
    }
  }

  const toggleShare = (): void => {
    if (isSharing) {
      void stopShare()
    } else {
      void startShare()
    }
  }

  const leaveRoom = () => {
    if (telemetryConnectionId) {
      telemetry.trackUserDisconnectBeacon(telemetryConnectionId)
    }
    if (telemetrySessionId) {
      telemetry.endRoomSessionBeacon(telemetrySessionId)
    }
    stopQualityPolling()
    peers.forEach((_, id) => removeRemotePeer(id))
    localStream?.getTracks().forEach(t => t.stop())
    ws?.close()
    globalThis.location.href = '/'
  }

  /* ── draggable self-view (mouse + touch) ── */
  const makeDraggable = (el: HTMLElement) => {
    let offsetX = 0
    let offsetY = 0
    let dragging = false

    const clampPosition = (x: number, y: number) => {
      const parent = el.parentElement
      if (!parent) return { x, y }
      const parentRect = parent.getBoundingClientRect()
      const elRect = el.getBoundingClientRect()
      const maxX = parentRect.width - elRect.width
      const maxY = parentRect.height - elRect.height
      return {
        x: Math.max(0, Math.min(x, maxX)),
        y: Math.max(0, Math.min(y, maxY)),
      }
    }

    const startDrag = (clientX: number, clientY: number) => {
      const parent = el.parentElement
      if (!parent) return
      const parentRect = parent.getBoundingClientRect()
      const elRect = el.getBoundingClientRect()
      // Cursor position inside the element, in viewport coords.
      offsetX = clientX - elRect.left
      offsetY = clientY - elRect.top
      el.style.right = 'auto'
      el.style.bottom = 'auto'
      el.style.left = `${elRect.left - parentRect.left}px`
      el.style.top = `${elRect.top - parentRect.top}px`
      dragging = true
      el.classList.add('dragging')
    }

    const moveDrag = (clientX: number, clientY: number) => {
      if (!dragging) return
      const parent = el.parentElement
      if (!parent) return
      const parentRect = parent.getBoundingClientRect()
      // New element viewport-left = clientX - offsetX;
      // Convert back to parent-relative by subtracting parentRect.left.
      const x = clientX - offsetX - parentRect.left
      const y = clientY - offsetY - parentRect.top
      const clamped = clampPosition(x, y)
      el.style.left = `${clamped.x}px`
      el.style.top = `${clamped.y}px`
    }

    const endDrag = () => {
      dragging = false
      el.classList.remove('dragging')
    }

    el.addEventListener('mousedown', e => {
      e.preventDefault()
      startDrag(e.clientX, e.clientY)
    })
    document.addEventListener('mousemove', e => moveDrag(e.clientX, e.clientY))
    document.addEventListener('mouseup', endDrag)

    el.addEventListener('touchstart', e => {
      const t = e.touches[0]
      if (!t) return
      startDrag(t.clientX, t.clientY)
    }, { passive: true })
    document.addEventListener('touchmove', e => {
      if (!dragging) return
      const t = e.touches[0]
      if (!t) return
      e.preventDefault()
      moveDrag(t.clientX, t.clientY)
    }, { passive: false })
    document.addEventListener('touchend', endDrag)
    document.addEventListener('touchcancel', endDrag)
  }

  /* ── resilience: heartbeat / reconnect / visibility / track recovery ── */
  const stopHeartbeat = (): void => {
    if (heartbeatTimer) clearInterval(heartbeatTimer)
    if (heartbeatPongTimer) clearTimeout(heartbeatPongTimer)
    heartbeatTimer = undefined
    heartbeatPongTimer = undefined
  }

  const startHeartbeat = (): void => {
    stopHeartbeat()
    heartbeatTimer = setInterval(() => {
      if (!ws || ws.readyState !== WebSocket.OPEN) return
      lastHeartbeatSent = Date.now()
      sendWs({ type: 'ping', t: lastHeartbeatSent })
      heartbeatPongTimer = setTimeout(() => {
        log('stability:ws:heartbeat:stale', 'warn')
        try {
          ws?.close(4000, 'heartbeat-timeout')
        } catch {}
      }, HEARTBEAT_TIMEOUT_MS)
    }, HEARTBEAT_INTERVAL_MS)
  }

  const scheduleReconnect = (): void => {
    if (shutdownRequested || reconnectTimer) return
    if (document.visibilityState === 'hidden') {
      // Wait for visibility resume — no point burning battery.
      return
    }
    const base = Math.min(
      WS_BACKOFF_MAX_MS,
      WS_BACKOFF_MIN_MS * 2 ** wsAttempt
    )
    const jitter = base * (0.75 + Math.random() * 0.5)
    wsAttempt++
    setConnState('reconnecting')
    log(
      `stability:ws:reconnect:scheduled attempt=${String(wsAttempt)} in=${String(Math.round(jitter))}ms`,
      'warn'
    )
    reconnectTimer = setTimeout(() => {
      reconnectTimer = undefined
      void connectWs()
    }, jitter)
  }

  const connectWs = async (): Promise<void> => {
    if (shutdownRequested) return
    setConnState(wsAttempt > 0 ? 'reconnecting' : 'connecting')
    log(`Connecting to ${wsUrl}...`)
    try {
      ws = new WebSocket(wsUrl)
    } catch {
      scheduleReconnect()
      return
    }
    ws.binaryType = 'arraybuffer'
    ws.addEventListener('open', () => {
      wsAttempt = 0
      setConnState('connected')
      log('Signaling connected', 'success')
      log('stability:ws:reconnected', 'success')
      startHeartbeat()
      // After a reconnect, re-check peer health so stuck peers recover.
      for (const [remoteId, peer] of peers.entries()) {
        const state = peer.pc.iceConnectionState
        if (state === 'failed' || state === 'disconnected') {
          void restartPeerIce(remoteId)
        }
      }
    })
    ws.addEventListener('close', () => {
      stopHeartbeat()
      log('Signaling disconnected', 'warn')
      if (!shutdownRequested) {
        setConnState('offline')
        scheduleReconnect()
      }
    })
    ws.addEventListener('error', () => {
      log('Signaling error', 'error')
    })
    ws.addEventListener('message', e => {
      if (e.data instanceof ArrayBuffer) {
        if (e.data.byteLength <= PEER_ID_BYTES + 1) return
        const senderId = new TextDecoder().decode(
          new Uint8Array(e.data, 0, PEER_ID_BYTES)
        )
        const type = new Uint8Array(e.data, PEER_ID_BYTES, 1)[0]
        const payload = e.data.slice(PEER_ID_BYTES + 1)
        handleRelayData(senderId, type ?? 0, payload)
      } else {
        handleSignalingMessage(e.data)
      }
    })
  }

  const reacquireLocalTrack = async (kind: 'video' | 'audio'): Promise<void> => {
    log(`stability:track:reacquire:${kind}:start`, 'warn')
    try {
      const fresh = await globalThis.navigator.mediaDevices.getUserMedia(
        kind === 'video' ? { video: true } : { audio: true }
      )
      const newTrack = fresh.getTracks()[0]
      if (!newTrack) return
      // Swap on every peer sender.
      for (const peer of peers.values()) {
        const sender = peer.pc
          .getSenders()
          .find(s => s.track?.kind === kind)
        if (sender) await sender.replaceTrack(newTrack)
        if (kind === 'video' && peer.relayActive && peer.relaySourceVideo) {
          peer.relaySourceVideo.srcObject = new MediaStream([newTrack])
          peer.relaySourceVideo.play().catch(() => {})
        }
      }
      if (localStream) {
        const old = localStream.getTracks().find(t => t.kind === kind)
        if (old) localStream.removeTrack(old)
        localStream.addTrack(newTrack)
      }
      if (kind === 'video') {
        const localVideo = $<HTMLVideoElement>('#local-video')
        if (localVideo && localStream) localVideo.srcObject = localStream
      }
      attachTrackRecovery(newTrack, kind)
      log(`stability:track:reacquire:${kind}:ok`, 'success')
    } catch {
      log(`stability:track:reacquire:${kind}:failed`, 'error')
      notify(`${kind === 'video' ? 'Camera' : 'Microphone'} unavailable`)
    }
  }

  const attachTrackRecovery = (
    track: MediaStreamTrack,
    kind: 'video' | 'audio'
  ): void => {
    track.addEventListener(
      'ended',
      () => {
        log(`stability:track:ended:${kind}`, 'warn')
        void reacquireLocalTrack(kind)
      },
      { once: true }
    )
  }

  /* Poll RTCPeerConnection.getStats for the first connected remote
     peer every 5s and push the result as a quality sample. */
  const stopQualityPolling = (): void => {
    if (qualityPollTimer) clearInterval(qualityPollTimer)
    qualityPollTimer = undefined
  }
  const startQualityPolling = (): void => {
    stopQualityPolling()
    qualityPollTimer = setInterval(() => {
      void sampleQuality()
    }, 5000)
  }
  const sampleQuality = async (): Promise<void> => {
    if (!telemetryConnectionId) return
    const peer = peers.values().next().value as
      | { pc: RTCPeerConnection }
      | undefined
    if (!peer) return
    try {
      const stats = await peer.pc.getStats()
      let rttMs = 0
      let jitterMs = 0
      let packetLossPct = 0
      let bitrateKbps = 0
      let inboundBytes = 0
      let inboundPackets = 0
      let inboundLost = 0
      stats.forEach(report => {
        if (report.type === 'candidate-pair' && report.state === 'succeeded') {
          const r = report as RTCIceCandidatePairStats & { currentRoundTripTime?: number }
          if (typeof r.currentRoundTripTime === 'number') {
            rttMs = r.currentRoundTripTime * 1000
          }
        }
        if (report.type === 'inbound-rtp') {
          const r = report as RTCInboundRtpStreamStats & {
            bytesReceived?: number
            packetsReceived?: number
            packetsLost?: number
            jitter?: number
          }
          if (typeof r.bytesReceived === 'number') inboundBytes += r.bytesReceived
          if (typeof r.packetsReceived === 'number') inboundPackets += r.packetsReceived
          if (typeof r.packetsLost === 'number') inboundLost += r.packetsLost
          if (typeof r.jitter === 'number') jitterMs = Math.max(jitterMs, r.jitter * 1000)
        }
      })
      bitrateKbps = (inboundBytes * 8) / 1000 / 5
      const totalPackets = inboundPackets + inboundLost
      packetLossPct =
        totalPackets > 0 ? (inboundLost / totalPackets) * 100 : 0
      void telemetry.pushQualitySample({
        connectionId: telemetryConnectionId,
        timestamp: new Date().toISOString(),
        rttMs,
        jitterMs,
        packetLossPct,
        bitrateKbps,
      })
    } catch {
      /* ignore — telemetry must never break the call */
    }
  }

  const handleVisibilityResume = (): void => {
    log('stability:visibility:resume', 'warn')
    if (!ws || ws.readyState !== WebSocket.OPEN) {
      wsAttempt = 0
      scheduleReconnect()
    }
    if (localStream) {
      for (const track of localStream.getTracks()) {
        if (track.readyState === 'ended') {
          void reacquireLocalTrack(
            track.kind === 'video' ? 'video' : 'audio'
          )
        }
      }
    }
    for (const [remoteId, peer] of peers.entries()) {
      const state = peer.pc.iceConnectionState
      if (state === 'disconnected' || state === 'failed') {
        void restartPeerIce(remoteId)
      }
    }
    log('stability:visibility:resume:recovered', 'success')
  }

  /* ── init ── */
  const init = async () => {
    const roomId = getRoomId()
    const info = $('#room-info')
    if (info) info.textContent = `Room: ${roomId.slice(0, 8)}...`

    const localNickname = await promptNickname(roomId)
    localNicknameRef = localNickname
    log(`Joined as "${localNickname}"`, 'success')

    // Telemetry: start (or join) the room session record. The session
    // id is the roomId itself so multiple peers in the same room
    // share the row (collector uses INSERT OR IGNORE).
    telemetrySessionId = roomId
    void telemetry
      .startRoomSession(roomId)
      .catch(() => {
        /* fire-and-forget */
      })

    /* copy link */
    $('#copy-link')?.addEventListener('click', () => {
      globalThis.navigator.clipboard.writeText(globalThis.location.href)
      notify('Link copied!')
    })

    /* controls */
    $('#btn-mic')?.addEventListener('click', toggleMic)
    $('#btn-cam')?.addEventListener('click', toggleCam)
    $('#btn-share')?.addEventListener('click', toggleShare)
    $('#btn-leave')?.addEventListener('click', leaveRoom)

    /* keyboard shortcut: Ctrl+Shift+L toggles the log panel.
       Guarded against text inputs so it doesn't hijack typing. */
    const isTextEditingTarget = (el: EventTarget | null): boolean => {
      if (!(el instanceof HTMLElement)) return false
      const tag = el.tagName
      return (
        tag === 'INPUT' ||
        tag === 'TEXTAREA' ||
        el.isContentEditable
      )
    }
    const toggleLogPanel = (): void => {
      const logBtn = $('#btn-log')
      const logPanel = $('#log-panel')
      const chatPanel = $('#chat-panel')
      const isOpen = logPanel?.classList.toggle('hidden') === false
      logBtn?.setAttribute('aria-pressed', String(isOpen))
      chatPanel?.classList.add('hidden')
      $('#btn-chat')?.setAttribute('aria-pressed', 'false')
    }
    document.addEventListener('keydown', e => {
      if (isTextEditingTarget(e.target)) return
      if (e.ctrlKey && e.shiftKey && (e.key === 'L' || e.key === 'l')) {
        e.preventDefault()
        toggleLogPanel()
      }
    })

    /* panels */
    $('#btn-chat')?.addEventListener('click', () => {
      const chat = $('#chat-panel')
      const isOpen = chat?.classList.toggle('hidden') === false
      $('#btn-chat')?.setAttribute('aria-pressed', String(isOpen))
      $('#log-panel')?.classList.add('hidden')
      $('#btn-log')?.setAttribute('aria-pressed', 'false')
    })
    $('#btn-log')?.addEventListener('click', () => {
      const log = $('#log-panel')
      const isOpen = log?.classList.toggle('hidden') === false
      $('#btn-log')?.setAttribute('aria-pressed', String(isOpen))
      $('#chat-panel')?.classList.add('hidden')
      $('#btn-chat')?.setAttribute('aria-pressed', 'false')
    })
    $('#close-chat')?.addEventListener('click', () => {
      $('#chat-panel')?.classList.add('hidden')
      $('#btn-chat')?.setAttribute('aria-pressed', 'false')
    })
    $('#close-log')?.addEventListener('click', () => {
      $('#log-panel')?.classList.add('hidden')
      $('#btn-log')?.setAttribute('aria-pressed', 'false')
    })

    /* chat form */
    $('#chat-form')?.addEventListener('submit', e => {
      e.preventDefault()
      const input = $<HTMLInputElement>('#chat-input')
      if (!input?.value.trim()) return
      const text = input.value.trim()
      if (!sendWs({ type: 'chat', text })) {
        notify('Disconnected — message not sent')
        return
      }
      addChatMessage(localNicknameRef || localNickname, text)
      input.value = ''
    })

    /* draggable self-view */
    const selfView = $('#self-view')
    if (selfView) makeDraggable(selfView)

    /* rename button */
    $('#btn-rename')?.addEventListener('click', () => {
      void openRenameDialog(roomId)
    })

    /* acquire media */
    log('Requesting camera and microphone...')
    try {
      localStream = await globalThis.navigator.mediaDevices.getUserMedia({
        video: true,
        audio: true,
      })
      const localVideo = $<HTMLVideoElement>('#local-video')
      if (localVideo) localVideo.srcObject = localStream
      for (const track of localStream.getTracks()) {
        attachTrackRecovery(
          track,
          track.kind === 'video' ? 'video' : 'audio'
        )
      }
      log('Camera acquired', 'success')
    } catch {
      log('Camera unavailable. Joining without video.', 'warn')
    }

    /* connect signaling (resilient) */
    const proto = globalThis.location.protocol === 'https:' ? 'wss:' : 'ws:'
    wsUrl = `${proto}//${getSignalHost()}/ws/room/${roomId}?nickname=${encodeURIComponent(localNickname)}`
    await connectWs()

    /* visibility handling: on resume, re-check everything. */
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        handleVisibilityResume()
      } else {
        log('stability:visibility:hidden')
      }
    })

    /* graceful shutdown */
    globalThis.addEventListener('pagehide', () => {
      shutdownRequested = true
      stopHeartbeat()
      stopQualityPolling()
      if (telemetryConnectionId) {
        telemetry.trackUserDisconnectBeacon(telemetryConnectionId)
      }
      if (telemetrySessionId) {
        telemetry.endRoomSessionBeacon(telemetrySessionId)
      }
      try { ws?.close(1000, 'pagehide') } catch {}
    })

    updatePeerCount()

    /* e2e debug surface — safe to expose: same info is already visible
       in DevTools. Tests poke this to simulate failure modes. */
    ;(globalThis as Record<string, unknown>)['__rtc'] = {
      get ws() { return ws },
      get peers() { return peers },
      get localStream() { return localStream },
      get userId() { return userId },
      get telemetryCalls() {
        return (globalThis as Record<string, unknown>)['__telemetryCalls']
      },
      get telemetrySessionId() { return telemetrySessionId },
      get telemetryConnectionId() { return telemetryConnectionId },
      connectWs,
      handleVisibilityResume,
      reacquireLocalTrack,
      restartPeerIce,
    }
  }

  const openRenameDialog = async (_roomId: string): Promise<void> => {
    const dialog = $<HTMLDialogElement>('#nickname-dialog')
    const input = $<HTMLInputElement>('#nickname-input')
    const title = $<HTMLElement>('#nickname-title')
    if (!dialog || !input || !title) return
    title.textContent = 'Change your nickname'
    input.value = localNicknameRef
    dialog.showModal()
    requestAnimationFrame(() => {
      input.focus()
      input.select()
    })
    const form = $<HTMLFormElement>('#nickname-form')
    if (!form) return
    const submit = (e: Event): void => {
      e.preventDefault()
      const newNick = input.value.trim()
      if (!newNick || newNick.length > 32) return
      if (newNick === localNicknameRef) {
        dialog.close()
        return
      }
      if (!sendWs({ type: 'rename', nickname: newNick })) {
        notify('Disconnected — rename not sent')
        return
      }
      dialog.close()
      form.removeEventListener('submit', submit)
    }
    form.addEventListener('submit', submit)
  }

  void init()
</script>

