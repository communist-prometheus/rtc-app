---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;

const { id } = Astro.params;
---

<BaseLayout title={`Room ${id ?? ''} | rtc-less`} description="Join a peer-to-peer video call">
  <section class="room-shell" data-room-id={id}>
    <header class="room-header container">
      <h1 class="visually-hidden">Video Room</h1>
      <output class="room-id text-sm text-secondary" aria-label="Room identifier">
        Room: <code>{id}</code>
      </output>
      <button
        type="button"
        class="button button-ghost text-sm"
        id="copy-link-btn"
        aria-label="Copy room link to clipboard"
      >
        Copy Link
      </button>
    </header>

    <section class="video-area" aria-label="Video feeds">
      <rtc-video-grid id="video-grid">
        <rtc-video-tile id="local-tile" label="You (local)"></rtc-video-tile>
      </rtc-video-grid>
    </section>

    <footer class="controls-bar">
      <rtc-controls id="rtc-controls"></rtc-controls>
    </footer>

    <aside class="log-area">
      <rtc-log-panel id="log-panel" expanded></rtc-log-panel>
    </aside>
  </section>
</BaseLayout>

<script>
  import '@rtc-less/rtc-components';

  /* -----------------------------------------------------------
   * Types
   * --------------------------------------------------------- */
  interface SignalingMessage {
    readonly type: 'offer' | 'answer' | 'ice-candidate' | 'join' | 'leave';
    readonly from: string;
    readonly to?: string | undefined;
    readonly payload?: unknown;
  }

  /* -----------------------------------------------------------
   * Helpers
   * --------------------------------------------------------- */
  const generateUserId = (): string =>
    globalThis.crypto.randomUUID().slice(0, 8);

  const log = (message: string, level: string = 'info'): void => {
    const panel = document.getElementById('log-panel');
    if (panel && 'addEntry' in panel) {
      (panel as { addEntry: (m: string, l: string) => void }).addEntry(message, level);
    }
  };

  /* -----------------------------------------------------------
   * ICE configuration
   * --------------------------------------------------------- */
  const iceServers: ReadonlyArray<RTCIceServer> = [
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
  ];

  /* -----------------------------------------------------------
   * State
   * --------------------------------------------------------- */
  const state = {
    userId: generateUserId(),
    roomId: '',
    localStream: undefined as MediaStream | undefined,
    peers: new Map<string, RTCPeerConnection>(),
    ws: undefined as WebSocket | undefined,
    audioMuted: false,
    videoMuted: false,
  };

  /* -----------------------------------------------------------
   * DOM references
   * --------------------------------------------------------- */
  const getLocalTile = (): HTMLElement | undefined =>
    document.getElementById('local-tile') ?? undefined;

  const getVideoGrid = (): HTMLElement | undefined =>
    document.getElementById('video-grid') ?? undefined;

  const getControls = (): HTMLElement | undefined =>
    document.getElementById('rtc-controls') ?? undefined;

  /* -----------------------------------------------------------
   * Media
   * --------------------------------------------------------- */
  const withTimeout = <T,>(
    promise: Promise<T>,
    ms: number
  ): Promise<T> =>
    Promise.race([
      promise,
      new Promise<never>((_, reject) =>
        setTimeout(
          () => reject(new Error('Timeout')),
          ms
        )
      ),
    ]);

  const acquireMedia = async (): Promise<MediaStream> => {
    log('Requesting camera and microphone access...');
    const stream = await withTimeout(
      globalThis.navigator.mediaDevices.getUserMedia({
        video: true,
        audio: true,
      }),
      5000
    );
    log('Local media acquired', 'success');
    return stream;
  };

  const attachLocalStream = (stream: MediaStream): void => {
    state.localStream = stream;
    const tile = getLocalTile();
    if (tile) {
      Object.assign(tile, { stream, muted: true });
    }
  };

  /* -----------------------------------------------------------
   * Peer connection
   * --------------------------------------------------------- */
  const createPeerConnection = (remoteUserId: string): RTCPeerConnection => {
    const pc = new RTCPeerConnection({ iceServers: [...iceServers] });

    state.localStream?.getTracks().forEach((track) => {
      if (state.localStream) {
        pc.addTrack(track, state.localStream);
      }
    });

    pc.addEventListener('icecandidate', (event) => {
      if (event.candidate) {
        sendSignaling({
          type: 'ice-candidate',
          from: state.userId,
          to: remoteUserId,
          payload: event.candidate.toJSON(),
        });
        log(`ICE candidate sent to ${remoteUserId}`);
      }
    });

    pc.addEventListener('iceconnectionstatechange', () => {
      log(`ICE state with ${remoteUserId}: ${pc.iceConnectionState}`,
        pc.iceConnectionState === 'connected' ? 'success' :
        pc.iceConnectionState === 'failed' ? 'error' : 'info');
      updateRemoteTileState(remoteUserId, pc.iceConnectionState);
    });

    pc.addEventListener('track', (event) => {
      log(`Remote track received from ${remoteUserId}`, 'success');
      const remoteStream = event.streams[0];
      if (remoteStream) {
        attachRemoteStream(remoteUserId, remoteStream);
      }
    });

    state.peers.set(remoteUserId, pc);
    log(`Peer connection created for ${remoteUserId}`);
    return pc;
  };

  const attachRemoteStream = (userId: string, stream: MediaStream): void => {
    const existingTile = document.querySelector(`rtc-video-tile[userid="${userId}"]`);
    if (existingTile) {
      Object.assign(existingTile, { stream });
      return;
    }

    const tile = document.createElement('rtc-video-tile');
    Object.assign(tile, {
      stream,
      userId,
      label: `Peer ${userId}`,
      connectionState: 'new',
    });
    getVideoGrid()?.appendChild(tile);
  };

  const updateRemoteTileState = (userId: string, iceState: string): void => {
    const tile = document.querySelector(`rtc-video-tile[userid="${userId}"]`);
    if (tile) {
      Object.assign(tile, { connectionState: iceState });
    }
  };

  const removePeer = (userId: string): void => {
    const pc = state.peers.get(userId);
    if (pc) {
      pc.close();
      state.peers.delete(userId);
    }
    const tile = document.querySelector(`rtc-video-tile[userid="${userId}"]`);
    tile?.remove();
    log(`Peer ${userId} disconnected`, 'warn');
  };

  /* -----------------------------------------------------------
   * Signaling
   * --------------------------------------------------------- */
  const sendSignaling = (message: SignalingMessage): void => {
    if (state.ws?.readyState === WebSocket.OPEN) {
      state.ws.send(JSON.stringify(message));
    }
  };

  const handleOffer = async (from: string, offer: RTCSessionDescriptionInit): Promise<void> => {
    log(`Offer received from ${from}`);
    const pc = createPeerConnection(from);
    await pc.setRemoteDescription(offer);
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    sendSignaling({
      type: 'answer',
      from: state.userId,
      to: from,
      payload: answer,
    });
    log(`Answer sent to ${from}`, 'success');
  };

  const handleAnswer = async (from: string, answer: RTCSessionDescriptionInit): Promise<void> => {
    log(`Answer received from ${from}`);
    const pc = state.peers.get(from);
    if (pc) {
      await pc.setRemoteDescription(answer);
      log(`Remote description set for ${from}`, 'success');
    }
  };

  const handleIceCandidate = async (from: string, candidate: RTCIceCandidateInit): Promise<void> => {
    const pc = state.peers.get(from);
    if (pc) {
      await pc.addIceCandidate(new RTCIceCandidate(candidate));
      log(`ICE candidate added from ${from}`);
    }
  };

  const handleJoin = async (from: string): Promise<void> => {
    log(`Peer ${from} joined, creating offer...`);
    const pc = createPeerConnection(from);
    const offer = await pc.createOffer();
    await pc.setLocalDescription(offer);
    sendSignaling({
      type: 'offer',
      from: state.userId,
      to: from,
      payload: offer,
    });
    log(`Offer sent to ${from}`, 'success');
  };

  const connectSignaling = (roomId: string): void => {
    const signalingHost = (globalThis as Record<string, unknown>)['__SIGNALING_HOST'] ?? globalThis.location.host;
    const protocol = globalThis.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${signalingHost}/ws/room/${roomId}`;
    log(`Connecting to signaling server at ${wsUrl}...`);

    const ws = new WebSocket(wsUrl);
    state.ws = ws;

    ws.addEventListener('open', () => {
      log('Signaling connected', 'success');
      sendSignaling({
        type: 'join',
        from: state.userId,
      });
    });

    ws.addEventListener('message', (event) => {
      const data = JSON.parse(String(event.data)) as SignalingMessage;

      if (data.from === state.userId) return;
      if (data.to && data.to !== state.userId) return;

      switch (data.type) {
        case 'join':
          void handleJoin(data.from);
          break;
        case 'offer':
          void handleOffer(data.from, data.payload as RTCSessionDescriptionInit);
          break;
        case 'answer':
          void handleAnswer(data.from, data.payload as RTCSessionDescriptionInit);
          break;
        case 'ice-candidate':
          void handleIceCandidate(data.from, data.payload as RTCIceCandidateInit);
          break;
        case 'leave':
          removePeer(data.from);
          break;
      }
    });

    ws.addEventListener('close', () => {
      log('Signaling connection closed', 'warn');
    });

    ws.addEventListener('error', () => {
      log('Signaling connection error', 'error');
    });
  };

  /* -----------------------------------------------------------
   * Controls
   * --------------------------------------------------------- */
  const bindControls = (): void => {
    const controls = getControls();
    if (!controls) return;

    controls.addEventListener('rtc-mute-toggle', () => {
      state.audioMuted = !state.audioMuted;
      state.localStream?.getAudioTracks().forEach((track) => {
        track.enabled = !state.audioMuted;
      });
      Object.assign(controls, { audioMuted: state.audioMuted });
      log(state.audioMuted ? 'Microphone muted' : 'Microphone unmuted');
    });

    controls.addEventListener('rtc-camera-toggle', () => {
      state.videoMuted = !state.videoMuted;
      state.localStream?.getVideoTracks().forEach((track) => {
        track.enabled = !state.videoMuted;
      });
      Object.assign(controls, { videoMuted: state.videoMuted });
      log(state.videoMuted ? 'Camera off' : 'Camera on');
    });

    controls.addEventListener('rtc-screen-toggle', () => {
      log('Screen sharing is not yet implemented', 'warn');
    });

    controls.addEventListener('rtc-leave', () => {
      sendSignaling({ type: 'leave', from: state.userId });
      state.peers.forEach((_pc, userId) => removePeer(userId));
      state.localStream?.getTracks().forEach((track) => track.stop());
      state.ws?.close();
      globalThis.location.href = '/';
    });
  };

  /* -----------------------------------------------------------
   * Copy link
   * --------------------------------------------------------- */
  const bindCopyLink = (): void => {
    const btn = document.getElementById('copy-link-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      void globalThis.navigator.clipboard.writeText(globalThis.location.href).then(() => {
        btn.textContent = 'Copied!';
        globalThis.setTimeout(() => { btn.textContent = 'Copy Link'; }, 2000);
        log('Room link copied to clipboard', 'success');
      });
    });
  };

  /* -----------------------------------------------------------
   * Init
   * --------------------------------------------------------- */
  const init = async (): Promise<void> => {
    const shell = document.querySelector<HTMLElement>('[data-room-id]');
    const roomId = shell?.dataset['roomId'];
    if (!roomId) return;

    state.roomId = roomId;
    log(`Joining room ${roomId} as user ${state.userId}`);

    bindControls();
    bindCopyLink();

    try {
      const stream = await acquireMedia();
      attachLocalStream(stream);
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Unknown error';
      log(`Media unavailable: ${message}. Joining without camera.`, 'warn');
    }

    connectSignaling(roomId);
  };

  void init();
</script>

<style>
  .room-shell {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    grid-template-areas:
      "header"
      "video"
      "controls"
      "log";
    min-height: calc(100dvh - 3.5rem);
  }

  .room-header {
    grid-area: header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--spacing-xs);
  }

  .room-id code {
    font-family: var(--font-mono);
    background: var(--color-surface);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .video-area {
    grid-area: video;
    padding: var(--spacing-xs);
    background: var(--color-surface);
    overflow: hidden;
  }

  .controls-bar {
    grid-area: controls;
    display: flex;
    justify-content: center;
    padding: var(--spacing-xs);
    border-block-start: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .log-area {
    grid-area: log;
    padding: var(--spacing-xs);
    max-height: 20rem;
    overflow: auto;
  }
</style>
