---
import BaseLayout from '@/layouts/BaseLayout.astro';

const features = [
  {
    title: 'No signup required',
    description: 'Create a room and share the link. No accounts, no passwords, no friction.',
    icon: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 14a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z',
  },
  {
    title: 'End-to-end encrypted',
    description: 'All media flows directly between peers via WebRTC. No server ever sees your data.',
    icon: 'M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2Zm10-10V7a4 4 0 0 0-8 0v4h8Z',
  },
  {
    title: 'NAT traversal',
    description: 'ICE, STUN, and TURN ensure connectivity even behind restrictive firewalls.',
    icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.558',
  },
] as const;
---

<BaseLayout title="rtc-less | Video calls without complexity" description="Peer-to-peer video conferencing with no signup, end-to-end encryption, and NAT traversal.">
  <section class="hero section">
    <hgroup class="container">
      <h1>Video calls without complexity</h1>
      <p class="subtitle text-secondary">
        Peer-to-peer video conferencing powered by WebRTC.
        No servers in the middle, no accounts to create.
      </p>
      <button type="button" class="button create-room" id="create-room-btn">
        Create Room
      </button>
    </hgroup>
  </section>

  <section class="features section" aria-labelledby="features-heading">
    <article class="container">
      <h2 id="features-heading" class="visually-hidden">Features</h2>
      <ul class="grid grid-3" role="list">
        {features.map((feature) => (
          <li class="card feature-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={feature.icon} />
            </svg>
            <h3>{feature.title}</h3>
            <p class="text-secondary text-sm">{feature.description}</p>
          </li>
        ))}
      </ul>
    </article>
  </section>
</BaseLayout>

<script>
  const createRoom = async (): Promise<void> => {
    const roomId = globalThis.crypto.randomUUID();
    globalThis.location.href = `/room/${roomId}`;
  };

  const bindCreateRoom = (): void => {
    const btn = document.getElementById('create-room-btn');
    if (!btn) return;
    btn.addEventListener('click', () => void createRoom());
  };

  bindCreateRoom();
  document.addEventListener('astro:after-swap', bindCreateRoom);
</script>

<style>
  .hero {
    text-align: center;
    padding-block: var(--spacing-2xl) var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: calc(var(--spacing-2xl) * 2) var(--spacing-2xl);
    }
  }

  hgroup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .subtitle {
    max-width: 36rem;
    font-size: 1.125rem;
  }

  .create-room {
    font-size: 1.0625rem;
    font-weight: 600;
    padding: var(--spacing-sm) var(--spacing-lg);
  }

  .create-room:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .features {
    padding-block-start: 0;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .feature-card svg {
    color: var(--color-accent);
  }

  .feature-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }
</style>
